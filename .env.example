# For a serverless deploy (Vercel), use Supabase's connection pooler string (port 6543,
# from the Supabase dashboard's Connect dialog -> "Transaction pooler" tab), not the direct
# :5432 connection — many short-lived serverless invocations exhaust direct connections fast.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Required on a serverless deploy (Vercel) — without it, every cold start would generate a
# fresh secret and invalidate every logged-in session. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The deployed student webportal's URL — set on whatever machine runs the DESKTOP app (it's
# the one that sends the enrollment welcome email and needs to link students to the portal).
# Not needed by the webportal deployment itself.
PORTAL_URL=https://your-app.vercel.app

# Optional — WhatsApp alerts (low attendance) alongside email, via Twilio's WhatsApp Sandbox.
# ACCOUNT_SID/AUTH_TOKEN come from the Twilio console; TWILIO_WHATSAPP_FROM defaults to the
# shared sandbox number (whatsapp:+14155238886) if left unset. Each recipient must opt in once
# by messaging "join <code>" (shown in Twilio Console -> Messaging -> Try it out -> WhatsApp)
# to that number from their own WhatsApp.
# (TWILIO_FROM_NUMBER / plain SMS is also wired up in code, but Twilio trial accounts can't
# send free-form SMS to Indian numbers — TRAI/DLT regulation — so WhatsApp is what's actually
# usable without a full business DLT registration.)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
