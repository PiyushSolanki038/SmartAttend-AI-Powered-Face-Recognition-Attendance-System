# For a serverless deploy (Vercel), use Supabase's connection pooler string (port 6543,
# from the Supabase dashboard's Connect dialog -> "Transaction pooler" tab), not the direct
# :5432 connection — many short-lived serverless invocations exhaust direct connections fast.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Required on a serverless deploy (Vercel) — without it, every cold start would generate a
# fresh secret and invalidate every logged-in session. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The deployed student webportal's URL — set on whatever machine runs the DESKTOP app (it's
# the one that sends the enrollment welcome email and needs to link students to the portal).
# Not needed by the webportal deployment itself.
PORTAL_URL=https://your-app.vercel.app
